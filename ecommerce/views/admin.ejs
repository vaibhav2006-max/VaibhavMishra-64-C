<%- include('header') %><h1>Seller Panel <small><a href="/admin/logout">(logout)</a></small></h1><div class="panel"><h3>Add New Product</h3><form method="POST" action="/admin/add"><input type="text" name="name" placeholder="Product name" required><input type="number" name="price" placeholder="Price" min="0" required><input type="text" name="image" placeholder="Image URL (optional)"><textarea name="description" placeholder="Description"></textarea><button type="submit">Add Product</button></form></div><h3>Your Products</h3><table><tr><th>Name</th><th>Price</th><th>Description</th><th>Actions</th></tr><% products.forEach(p=>{ %><tr><td><%= p.name %></td><td>Rs. <%= p.price %></td><td><%= p.description %></td><td><a href="/admin/edit/<%= p._id %>"><button>Edit</button></a><form method="POST" action="/admin/delete/<%= p._id %>" style="display:inline"><button class="red" onclick="return confirm('Delete this product?')">Delete</button></form></td></tr><% }) %></table><%- include('footer') %>
