<%- include('header') %><h1>My Successful Orders</h1><% if(orders.length===0){ %><p>No orders yet.</p><% } %><% orders.forEach(o=>{ %><div class="panel"><div class="success">Payment successful - ID <%= o.paymentId %></div><p><b>Order #<%= o._id %></b> | <%= o.createdAt.toLocaleString() %> | Status: <%= o.status %></p><p>Deliver to: <%= o.customer %>, <%= o.address %></p><ul><% o.items.forEach(i=>{ %><li><%= i.name %> x <%= i.qty %> = Rs. <%= i.price*i.qty %></li><% }) %></ul><b>Total: Rs. <%= o.total %></b></div><% }) %><%- include('footer') %>
