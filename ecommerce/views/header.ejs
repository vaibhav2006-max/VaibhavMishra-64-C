<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><title><%= title %> | ShopEasy</title>
<style>body{font-family:Arial,sans-serif;margin:0;background:#f5f6fa}nav{background:#2d3436;padding:14px 25px;display:flex;gap:20px}nav a{color:#fff;text-decoration:none}nav .brand{font-weight:bold;font-size:18px;margin-right:auto}.container{max-width:1000px;margin:25px auto;padding:0 15px}.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:18px}.card{background:#fff;padding:12px;border-radius:8px;box-shadow:0 2px 6px rgba(0,0,0,.12)}.card img{width:100%;height:140px;object-fit:cover;border-radius:6px}table{width:100%;border-collapse:collapse;background:#fff}th,td{padding:9px;border:1px solid #ddd;text-align:left}th{background:#dfe6e9}input,textarea{padding:8px;width:100%;box-sizing:border-box;margin-bottom:8px}button{padding:8px 16px;background:#0984e3;color:#fff;border:none;border-radius:4px;cursor:pointer}button.red{background:#d63031}.error{color:#c0392b}.success{background:#dff9e7;padding:10px;border-left:4px solid #27ae60;margin-bottom:10px}.panel{background:#fff;padding:15px;border-radius:8px;margin-bottom:20px}</style>
</head><body><nav><a class="brand" href="/">ShopEasy</a><a href="/">Products</a><a href="/cart">Cart (<%= cartCount %>)</a><a href="/orders">My Orders</a><a href="/admin">Seller Panel</a></nav><div class="container">
