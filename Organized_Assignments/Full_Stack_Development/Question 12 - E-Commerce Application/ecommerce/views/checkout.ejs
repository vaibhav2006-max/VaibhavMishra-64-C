<%- include('header') %><h1>Checkout</h1><p>Amount payable: <b>Rs. <%= total %></b></p><% if(error){ %><p class="error"><%= error %></p><% } %><form method="POST" action="/checkout" style="max-width:400px"><input type="text" name="customer" placeholder="Full name" value="<%= form.customer||'' %>" required><textarea name="address" placeholder="Delivery address" required><%= form.address||'' %></textarea><input type="text" name="cardNumber" placeholder="Card number (16 digits, demo)" required><button type="submit">Pay Rs. <%= total %></button></form><p><small>Demo payment: any 16-digit number is accepted. No card data is stored.</small></p><%- include('footer') %>
