<%- include('header') %><h1>Your Cart</h1><% if(cart.length===0){ %><p>Your cart is empty. <a href="/">Continue shopping</a></p><% }else{ %><table><tr><th>Product</th><th>Price</th><th>Qty</th><th>Subtotal</th><th></th></tr><% cart.forEach(i=>{ %><tr><td><%= i.name %></td><td>Rs. <%= i.price %></td><td><%= i.qty %></td><td>Rs. <%= i.price*i.qty %></td><td><form method="POST" action="/cart/remove/<%= i.id %>"><button class="red">Remove</button></form></td></tr><% }) %><tr><th colspan="3">Total</th><th colspan="2">Rs. <%= total %></th></tr></table><p><a href="/checkout"><button>Proceed to Checkout</button></a></p><% } %><%- include('footer') %>
