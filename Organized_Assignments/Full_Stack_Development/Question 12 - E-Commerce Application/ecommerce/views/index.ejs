<%- include('header') %><h1>All Products</h1><% if(products.length===0){ %><p>No products yet.</p><% } %><div class="grid"><% products.forEach(p=>{ %><div class="card"><img src="<%= p.image %>" alt="<%= p.name %>"><h3><%= p.name %></h3><p><%= p.description %></p><b>Rs. <%= p.price %></b><form method="POST" action="/cart/add/<%= p._id %>"><button type="submit">Add to Cart</button></form></div><% }) %></div><%- include('footer') %>
